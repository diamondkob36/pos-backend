generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- เริ่มพิมพ์เขียวตาราง ---

// พิมพ์เขียวสำหรับตารางสินค้า
model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Float
  image       String
  category    String      @default("") 
  isActive    Boolean     @default(true)
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
}

// พิมพ์เขียวสำหรับท็อปปิ้ง
model Topping {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  image       String?
  category    String   @default("") 
  isActive    Boolean  @default(true)
  isAvailable Boolean  @default(true)
}

// ตารางหมวดหมู่สินค้า
model Category {
  id        Int      @id @default(autoincrement())
  value     String   @unique  // ค่าอ้างอิงภาษาอังกฤษ (เช่น beverage, dessert)
  label     String            // ชื่อที่แสดงผล (เช่น เครื่องดื่ม, ขนมหวาน)
  hasType   Boolean  @default(false) // มีให้เลือก ร้อน/เย็น/ปั่น หรือไม่?
  hasSize   Boolean  @default(false) // มีให้เลือกขนาด (S, M, L) หรือไม่?
}

// พิมพ์เขียวสำหรับหัวบิล (ยอดรวม, วันที่)
model Order {
  id          Int         @id @default(autoincrement())
  dailyNumber Int         @default(1) // เลขบิล/เลขคิว ประจำวัน
  totalAmount Float
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

// ข้อมูลสินค้าแต่ละชิ้นในบิล
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float    // ราคาสุทธิที่รวมไซส์และท็อปปิ้งแล้ว (แช่แข็งราคาไว้ในบิล)
  size      String?  // ขนาดแก้ว (เช่น "ร้อน", "เย็น", "ปั่น")
  toppings  String?  // ท็อปปิ้ง (เช่น "ไข่มุก, เยลลี่") เก็บเป็นข้อความยาวๆ
  note      String?  // คอมเมนต์เพิ่มเติม (เช่น "หวานน้อย", "แยกน้ำ")

  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

// ตารางพนักงานและสิทธิ์การใช้งาน
model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String 
  role     String @default("cashier") // สิทธิ์: "manager" หรือ "cashier"
  name     String // ชื่อพนักงานที่แสดงบนหน้าจอ
  isActive Boolean @default(true)
}